# Application
DEMO_MODE=true
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Groq
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-120b

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Hindsight Cloud (https://api.hindsight.vectorize.io)
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=verichron-compliance

# OpenClaw (loopback gateway). Token is a secret — never commit it.
OPENCLAW_ENABLED=true
OPENCLAW_LEGACY_FALLBACK=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT=openclaw/default
OPENCLAW_MODEL=groq/openai/gpt-oss-120b
OPENCLAW_TOOL_TOKEN=
# Wizard SecretRef: HINDSIGHT_CLOUD_TOKEN (same value as HINDSIGHT_API_KEY)
HINDSIGHT_CLOUD_TOKEN=
